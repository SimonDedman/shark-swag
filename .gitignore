# Regenerable caches: re-created by harvest.py / pool.py at the cost of re-fetching
__pycache__/
images/raw/
images/htmlcache/
images/pool/
images/sheets/
images/*.log

# Contact sheets for verification, rebuilt by verify_sheet.py
images/verify*.jpg
images/_check_*.jpg

# Built deliverable: ~8 MB, regenerated by build_docx.py + add_images.py on
# every apply, so committing it would grow history by that much each time.
*.docx

# Intake runtime state: mail ledger, pending queue, review workbooks, logs.
# Carries Message-IDs and sender names, and is machine-local by nature.
intake/**/*.json
intake/**/*.xlsx
intake/**/*.log
intake/heartbeat
# state files renamed aside by intake_queue when they could not be read
intake/*.corrupt-*

# Chosen product images: third-party retailer photos, kept local for now
images/final/
